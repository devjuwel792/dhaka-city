# Dhaka City Smart Dashboard — public environment options
# Copy to `.env.local` to override. None of these are secrets: every value
# prefixed NEXT_PUBLIC_ is bundled into the browser, so never put API keys here.
# Restart / rebuild after changing (`npm run dev` or `npm run build`).

# Open-Meteo weather + CAMS air-quality endpoints. Override only if you proxy
# them (same CORS requirements). Leave commented to use the public defaults.
# NEXT_PUBLIC_OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# NEXT_PUBLIC_OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# NEXT_PUBLIC_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# GDELT DOC 2.0 news endpoint. GDELT currently sends no CORS headers and may
# rate-limit; the UI shows an unavailable state + labelled demo headlines.
# NEXT_PUBLIC_GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Default map/API centre coordinates (Dhaka).
# NEXT_PUBLIC_DHAKA_LAT=23.8103
# NEXT_PUBLIC_DHAKA_LON=90.4125
